# Arquivo de exemplo para variáveis de ambiente
# Copie este arquivo para .env e preencha com suas credenciais reais
# NUNCA commite o arquivo .env real no Git!

# Django Secret Key (gere uma nova para produção)
SECRET_KEY="django-insecure-sua-chave-secreta-aqui"

# Banco de dados (PostgreSQL - Neon.tech ou outro)
DATABASE_URL="postgresql://usuario:senha@host:porta/database"

# Cloudinary (para upload de imagens)
CLOUD_NAME='seu-cloud-name'
API_KEY='sua-api-key'
API_SECRET='seu-api-secret'

# Melhor Envio (API de frete)
MELHOR_ENVIO_TOKEN='seu-token-melhor-envio'

# Mercado Pago (pagamentos)
MERCADO_PAGO_PUBLIC_KEY='APP_USR-sua-public-key'
MERCADO_PAGO_TOKEN='APP_USR-seu-access-token'